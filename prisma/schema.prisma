// Istanbul Hostel — data model
// Localized text fields are stored as JSON objects: { "en": "...", "bs": "...", "tr": "..." }

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  ADMIN
  MANAGER
  RECEPTION
  HOUSEKEEPING
}

enum RoomKind {
  DORM
  PRIVATE
}

enum GenderPolicy {
  MIXED
  FEMALE
}

enum HousekeepingStatus {
  CLEAN
  DIRTY
  CLEANING
  INSPECTED
  MAINTENANCE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

enum RequestStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

enum TaskType {
  CLEANING
  INSPECTION
  MAINTENANCE
  CUSTOM
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ServiceRequestType {
  TOWELS
  CLEANING
  MAINTENANCE
  AMENITIES
  RECEPTION
  OTHER
}

enum ServiceRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum PlaceCategory {
  ATTRACTION
  RESTAURANT
  CAFE
  NEIGHBORHOOD
  NIGHTLIFE
}

enum GuideSection {
  FACILITY
  RULE
  TRANSPORT
}

enum BookingSource {
  WEBSITE
  GUEST_PORTAL
  ADMIN
}

// ───────────────────────── Property & settings ─────────────────────────

model Property {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  tagline       Json
  addressLine   String
  city          String
  country       String
  phone         String
  whatsapp      String
  email         String
  mapQuery      String
  latitude      Float?
  longitude     Float?
  currency      String   @default("EUR")
  timezone      String   @default("Europe/Istanbul")
  checkInTime   String   @default("14:00")
  checkOutTime  String   @default("11:00")
  reviewUrl     String?
  isDemo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  settings       Setting[]
  roomTypes      RoomType[]
  rooms          Room[]
  reservations   Reservation[]
  experiences    Experience[]
  tasks          Task[]
  places         Place[]
  guideItems     GuideItem[]
  guideConfig    GuideConfig?
  qrCodes        QrCode[]
  faqs           Faq[]
  testimonials   Testimonial[]
  contentBlocks  ContentBlock[]
  serviceRequests ServiceRequest[]
  transferRequests TransferRequest[]
  feedback       Feedback[]
  contactMessages ContactMessage[]
}

model Setting {
  id         String   @id @default(cuid())
  propertyId String
  key        String
  value      Json
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, key])
}

// ───────────────────────── Inventory ─────────────────────────

model RoomType {
  id               String       @id @default(cuid())
  propertyId       String
  slug             String
  name             Json
  summary          Json
  description      Json
  kind             RoomKind
  genderPolicy     GenderPolicy @default(MIXED)
  /// Beds per room for dorms, max guests for private rooms
  capacity         Int
  basePrice        Decimal      @db.Decimal(10, 2)
  sizeSqm          Int?
  bedSummary       Json
  amenities        String[]
  images           String[]
  sortOrder        Int          @default(0)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms        Room[]
  reservations Reservation[]

  @@unique([propertyId, slug])
  @@index([propertyId, isActive])
}

model Room {
  id                 String             @id @default(cuid())
  propertyId         String
  roomTypeId         String
  number             String
  floor              Int                @default(1)
  housekeepingStatus HousekeepingStatus @default(CLEAN)
  housekeepingNote   String?
  statusUpdatedAt    DateTime           @default(now())
  assignedToId       String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  property        Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType        RoomType          @relation(fields: [roomTypeId], references: [id])
  assignedTo      User?             @relation("RoomAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  beds            Bed[]
  allocations     Allocation[]
  blockedDates    BlockedDate[]
  housekeepingLog HousekeepingLog[]
  tasks           Task[]
  qrCodes         QrCode[]
  serviceRequests ServiceRequest[]

  @@unique([propertyId, number])
  @@index([roomTypeId])
  @@index([housekeepingStatus])
}

model Bed {
  id          String       @id @default(cuid())
  roomId      String
  label       String
  isActive    Boolean      @default(true)
  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocations Allocation[]

  @@unique([roomId, label])
}

model BlockedDate {
  id        String   @id @default(cuid())
  roomId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String
  createdAt DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startDate, endDate])
}

// ───────────────────────── Guests & reservations ─────────────────────────

model Guest {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  country      String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]

  @@index([email])
  @@index([lastName])
}

model Reservation {
  id              String            @id @default(cuid())
  reference       String            @unique
  propertyId      String
  roomTypeId      String
  guestId         String
  checkIn         DateTime          @db.Date
  checkOut        DateTime          @db.Date
  guests          Int
  /// Beds (dorm) or rooms (private) requested
  units           Int
  nightlyPrice    Decimal           @db.Decimal(10, 2)
  totalPrice      Decimal           @db.Decimal(10, 2)
  status          ReservationStatus @default(PENDING)
  specialRequests String?
  internalNote    String?
  statusReason    String?
  source          BookingSource     @default(WEBSITE)
  locale          String            @default("en")
  isDemo          Boolean           @default(false)
  confirmedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType    RoomType     @relation(fields: [roomTypeId], references: [id])
  guest       Guest        @relation(fields: [guestId], references: [id])
  allocations Allocation[]
  guestAccess GuestAccess[]
  serviceRequests ServiceRequest[]

  @@index([propertyId, status])
  @@index([checkIn, checkOut])
  @@index([roomTypeId, status])
}

/// Concrete room/bed assignment created when a reservation is confirmed
model Allocation {
  id            String      @id @default(cuid())
  reservationId String
  roomId        String
  bedId         String?
  checkIn       DateTime    @db.Date
  checkOut      DateTime    @db.Date
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room          Room        @relation(fields: [roomId], references: [id])
  bed           Bed?        @relation(fields: [bedId], references: [id])

  @@index([roomId, checkIn, checkOut])
  @@index([bedId, checkIn, checkOut])
}

/// Short-lived guest portal session created after verifying a reservation
model GuestAccess {
  id            String      @id @default(cuid())
  tokenHash     String      @unique
  reservationId String
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Staff & auth ─────────────────────────

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        Session[]
  assignedRooms   Room[]            @relation("RoomAssignee")
  assignedTasks   Task[]            @relation("TaskAssignee")
  createdTasks    Task[]            @relation("TaskCreator")
  taskEvents      TaskEvent[]
  housekeepingLog HousekeepingLog[]
  auditLogs       AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// ───────────────────────── Housekeeping & tasks ─────────────────────────

model Task {
  id           String       @id @default(cuid())
  propertyId   String
  roomId       String?
  title        String
  description  String?
  type         TaskType     @default(CUSTOM)
  priority     TaskPriority @default(NORMAL)
  status       TaskStatus   @default(OPEN)
  assignedToId String?
  createdById  String?
  dueAt        DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room       Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  assignedTo User?       @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  events     TaskEvent[]

  @@index([propertyId, status])
  @@index([assignedToId, status])
  @@index([roomId])
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  kind      String
  message   String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model HousekeepingLog {
  id         String              @id @default(cuid())
  roomId     String
  fromStatus HousekeepingStatus?
  toStatus   HousekeepingStatus
  userId     String?
  note       String?
  createdAt  DateTime            @default(now())
  room       Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
}

// ───────────────────────── Experiences ─────────────────────────

model Experience {
  id              String   @id @default(cuid())
  propertyId      String
  slug            String
  title           Json
  summary         Json
  description     Json
  meetingPoint    Json
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  /// "PERSON" or "GROUP"
  priceUnit       String   @default("PERSON")
  image           String
  /// 0 = Sunday … 6 = Saturday
  availableDays   Int[]
  startTime       String
  maxParticipants Int
  isTransfer      Boolean  @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookings ExperienceBooking[]

  @@unique([propertyId, slug])
}

model ExperienceBooking {
  id           String        @id @default(cuid())
  reference    String        @unique
  experienceId String
  date         DateTime      @db.Date
  participants Int
  totalPrice   Decimal       @db.Decimal(10, 2)
  name         String
  email        String
  phone        String?
  roomNumber   String?
  notes        String?
  status       RequestStatus @default(PENDING)
  source       BookingSource @default(WEBSITE)
  locale       String        @default("en")
  isDemo       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  experience   Experience    @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, date])
  @@index([status])
}

model TransferRequest {
  id           String        @id @default(cuid())
  reference    String        @unique
  propertyId   String
  airport      String
  direction    String        @default("ARRIVAL")
  flightNumber String
  arrivalAt    DateTime
  passengers   Int
  name         String
  email        String
  phone        String
  notes        String?
  status       RequestStatus @default(PENDING)
  locale       String        @default("en")
  isDemo       Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([status, arrivalAt])
}

// ───────────────────────── Guest portal ─────────────────────────

model GuideConfig {
  id                  String   @id @default(cuid())
  propertyId          String   @unique
  welcomeNote         Json
  wifiNetwork         String
  wifiPassword        String
  breakfastStart      String
  breakfastEnd        String
  breakfastLocation   Json
  breakfastMenu       Json
  luggageInfo         Json
  quietHoursStart     String
  quietHoursEnd       String
  smokingPolicy       Json
  checkoutSteps       Json
  receptionHours      Json
  updatedAt           DateTime @updatedAt
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model GuideItem {
  id         String       @id @default(cuid())
  propertyId String
  section    GuideSection
  icon       String       @default("info")
  title      Json
  body       Json
  sortOrder  Int          @default(0)
  isActive   Boolean      @default(true)
  updatedAt  DateTime     @updatedAt
  property   Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, section])
}

model Place {
  id             String        @id @default(cuid())
  propertyId     String
  category       PlaceCategory
  name           String
  description    Json
  area           String
  walkingMinutes Int?
  transitNote    Json?
  image          String?
  mapQuery       String
  sortOrder      Int           @default(0)
  isActive       Boolean       @default(true)
  updatedAt      DateTime      @updatedAt
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, category])
}

model ServiceRequest {
  id            String               @id @default(cuid())
  reference     String               @unique
  propertyId    String
  roomId        String?
  reservationId String?
  type          ServiceRequestType
  message       String
  status        ServiceRequestStatus @default(OPEN)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  property      Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room          Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reservation   Reservation?         @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model Feedback {
  id         String   @id @default(cuid())
  propertyId String
  rating     Int
  message    String
  name       String?
  roomNumber String?
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  email      String
  subject    String
  message    String
  handled    Boolean  @default(false)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model QrCode {
  id         String   @id @default(cuid())
  propertyId String
  label      String
  roomId     String?
  path       String
  scans      Int      @default(0)
  lastScanAt DateTime?
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room       Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Website content ─────────────────────────

model ContentBlock {
  id         String   @id @default(cuid())
  propertyId String
  key        String
  value      Json
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, key])
}

model Faq {
  id         String   @id @default(cuid())
  propertyId String
  question   Json
  answer     Json
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  origin     String
  quote      Json
  isSample   Boolean  @default(true)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Audit ─────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, createdAt])
  @@index([createdAt])
}
