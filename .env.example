DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/istanbul_hostel"
# 32+ random bytes, e.g. `openssl rand -hex 32`
SESSION_SECRET=""
# Public base URL used inside QR codes, e.g. https://hostel.example.com
APP_URL="http://localhost:3000"
# "true" shows demo sign-in hints on the login page. Never enable in production.
DEMO_MODE="false"
# Password applied to all seeded demo accounts. Leave empty to generate a random one.
DEMO_PASSWORD=""
